<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Explicit debug laboratory; no launcher or production route. -->
        <activity android:name=".epub.EpubDocumentLaboratoryActivity"
            android:exported="true" android:theme="@style/LaunchTheme"
            android:hardwareAccelerated="true" />
        <activity android:name=".reader.AlignmentLaboratoryActivity"
            android:exported="true" android:theme="@style/LaunchTheme" />
        <activity android:name=".reader.AlignmentCorpusLaboratoryActivity"
            android:exported="true" android:launchMode="singleTop" android:theme="@style/LaunchTheme" />
    </application>
</manifest>
