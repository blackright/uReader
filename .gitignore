# Validation: publish reproducible source, never local measurements or snapshots
/validation/*
!/validation/README.md
!/validation/scripts/
!/validation/protocols/
/validation/protocols/g0.md
!/validation/model-lock.json
!/validation/reference-3.3-aligned-lock.json
!/validation/epub/
!/validation/reader/
/validation/epub/*
!/validation/epub/scripts/
!/validation/epub/corpus-manifest.json
/validation/reader/*
!/validation/reader/scripts/
!/validation/reader/tools/
/android/app/src/androidTest/assets/epub-gate/

# Keep the application lockfile and Gradle wrapper for reproducible clones
!pubspec.lock
!android/gradlew
!android/gradlew.bat
!android/gradle/wrapper/gradle-wrapper.jar
